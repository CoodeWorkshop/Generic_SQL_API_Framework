{
    "version": 4,
    "server": {
        "apiPortMinimum": 8000,
        "apiPortMaximum": 8100,
        "parserPortMinimum": 8101,
        "parserPortMaximum": 8199,
        "adminPort": 8090,
        "bindAddress": "127.0.0.1"
    },
    "cors": {
        "allowedOrigins": [
            "http://127.0.0.1:5173",
            "http://localhost:5173"
        ],
        "credentialsEnabled": true,
        "allowedMethods": [
            "POST",
            "OPTIONS"
        ]
    },
    "authentication": {
        "mode": "session"
    }
}
